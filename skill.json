{
  "name": "vibe-coding-sop",
  "version": "1.1.3",
  "description": "5-阶段+4-横向+6-维技术评估的 vibe-coding 标准 SOP",
  "note": "每个阶段独立列出 required/optional skills，不需要一次性装完所有 skill。按阶段安装即可。",
  "skills_by_stage": {
    "阶段1-需求确认": {
      "required": ["brainstorming", "idea-refine"],
      "optional": ["interview-me", "planning-and-task-breakdown"]
    },
    "阶段2-技术评估": {
      "required": ["tech-stack-evaluator"],
      "optional": ["doubt-driven-development"]
    },
    "阶段3-开发": {
      "required": ["git-workflow-and-versioning", "api-and-interface-design", "frontend-ui-engineering", "incremental-implementation"],
      "optional": ["using-git-worktrees", "source-driven-development", "security-and-hardening", "debugging-and-error-recovery", "observability-and-instrumentation", "design-taste-frontend", "impeccable", "design-is", "UI Design Master"]
    },
    "阶段4-测试": {
      "required": ["code-test-expert", "verification-before-completion"],
      "optional": ["test-driven-development"]
    },
    "阶段5-代码审查": {
      "required": ["code-review-and-quality"],
      "optional": ["code-simplification", "doubt-driven-development"]
    }
  }
}
